{
  "settings":
   {
    "nlp":{
      "forceNER":true,
      "modelFileName":"model.nlp"
    },
    "api-server": {
      "port": 3000,
      "cors":{
        "origin": "http://localhost:3000",
        "credentials": true
      }
    },
    "bot": {
      "scripts": ["./script.dlg"],
      "actions": ["./actions"]
    }
  },
  "use": ["Basic",{
    "className": "ExpressApiServer",
    "path": "./custom-express-api-server"
  }, "DirectlineConnector", "Bot","ConsoleConnector"]
}
