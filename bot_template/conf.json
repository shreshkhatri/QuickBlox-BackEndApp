{
  "settings": {
    "nlp": {
      "forceNER": true,
      "modelFileName": "model.nlp",
      "threshold": 0.9
    },
    "api-server": {
      "port": 3000,
      "cors": {
        "origin": "http://localhost",
        "credentials": true
      }
    },
    "bot": {
      "scripts": [
        "./script.dlg"
      ],
      "actions": [
        "./actions"
      ]
    }
  },
  "use": [
    "Basic",
    {
      "className": "ExpressApiServer",
      "path": "./custom-express-api-server"
    },
    {
      "className": "DirectlineConnector",
      "path": "./custom-directline-connector"
    },
    {
      "className": "Bot",
      "path": "./custom-bot"
    },
    "ConsoleConnector"
  ]
}